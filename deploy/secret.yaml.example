# Copy to secret.yaml, fill in, then SOPS-encrypt it before it goes near git:
#   sops --encrypt secret.yaml > secret.yaml.enc && rm secret.yaml
#
# CNPG reads username/password from this same secret to bootstrap the database,
# which is why the credentials appear both on their own and inside the DSN.
apiVersion: v1
kind: Secret
metadata:
  name: planty-secrets
  namespace: planty
type: kubernetes.io/basic-auth
stringData:
  username: planty
  password: CHANGE_ME

  PLANTY_DATABASE_URL: postgres://planty:CHANGE_ME@planty-postgres-rw.planty.svc:5432/planty?sslmode=disable

  # Shared by the service, iOS app, and Dusk plugin. Generate a high-entropy
  # value; every application route rejects requests without it.
  PLANTY_API_TOKEN: CHANGE_ME

  # Long-lived Home Assistant token: still used for sensors, weather and
  # actuators. Planty's own phone notifications move to APNs when the four
  # values below are configured.
  PLANTY_HA_TOKEN: CHANGE_ME

  # Apple Push Notification service token key from Certificates, Identifiers &
  # Profiles. This is an APNs auth key, not the App Store Connect API key used
  # by the release workflow.
  PLANTY_APNS_KEY_ID: CHANGE_ME
  PLANTY_APNS_TEAM_ID: CHANGE_ME
  PLANTY_APNS_BUNDLE_ID: zone.stout.Planty
  PLANTY_APNS_ENVIRONMENT: production
  PLANTY_APNS_PRIVATE_KEY: |
    -----BEGIN PRIVATE KEY-----
    CHANGE_ME
    -----END PRIVATE KEY-----

  # MinIO, for the photo timeline.
  PLANTY_S3_ACCESS_KEY: CHANGE_ME
  PLANTY_S3_SECRET_KEY: CHANGE_ME

  # How the judge pays. With PLANTY_JUDGE=cli this is the whole of it: generate
  # it with `claude setup-token` on a machine signed in to the subscription.
  CLAUDE_CODE_OAUTH_TOKEN: CHANGE_ME

  # Only needed with PLANTY_JUDGE=api. Setting it also makes it the default,
  # so leave it out entirely when the subscription is meant to be paying.
  # ANTHROPIC_API_KEY: CHANGE_ME
