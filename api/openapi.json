{
  "openapi": "3.1.0",
  "info": {
    "title": "Planty API",
    "version": "1.0.0",
    "description": "Canonical machine-readable contract for Planty's HTTP routes and closed wire enums."
  },
  "paths": {
    "/healthz": {"get": {"operationId": "health"}},
    "/readyz": {"get": {"operationId": "ready"}},
    "/v1/plants": {
      "get": {"operationId": "listPlants"},
      "post": {"operationId": "createPlant"}
    },
    "/v1/plants/from-photo": {"post": {"operationId": "createPlantFromPhoto"}},
    "/v1/plants/{slug}": {
      "get": {"operationId": "getPlant"},
      "patch": {"operationId": "updatePlant"},
      "delete": {"operationId": "archivePlant"}
    },
    "/v1/plants/{slug}/restore": {"post": {"operationId": "restorePlant"}},
    "/v1/plants/{slug}/derive": {"post": {"operationId": "derivePlant"}},
    "/v1/plants/{slug}/observations": {
      "get": {"operationId": "listObservations"},
      "post": {"operationId": "addObservation"}
    },
    "/v1/plants/{slug}/health": {"get": {"operationId": "getPlantHealth"}},
    "/v1/plants/{slug}/health-events": {"post": {"operationId": "addHealthEvent"}},
    "/v1/evidence-coverage": {"get": {"operationId": "getEvidenceCoverage"}},
    "/v1/plants/{slug}/rechecks": {
      "get": {"operationId": "listRechecks"},
      "post": {"operationId": "proposeRecheck"}
    },
    "/v1/plants/{slug}/guardrails": {"get": {"operationId": "listGuardrails"}},
    "/v1/evidence-windows/{id}": {"get": {"operationId": "getEvidenceWindow"}},
    "/v1/evidence-windows/{id}/start": {"post": {"operationId": "startEvidenceWindow"}},
    "/v1/evidence-windows/{id}/review": {"post": {"operationId": "reviewEvidenceWindow"}},
    "/v1/evidence-windows/{id}/conclude": {"post": {"operationId": "concludeEvidenceWindow"}},
    "/v1/evidence-windows/{id}/cancel": {"post": {"operationId": "cancelEvidenceWindow"}},
    "/v1/guardrails/{id}/override": {"post": {"operationId": "overrideGuardrail"}},
    "/v1/experiments": {
      "get": {"operationId": "listExperiments"},
      "post": {"operationId": "proposeExperiment"}
    },
    "/v1/experiments/{id}": {"get": {"operationId": "getExperiment"}},
    "/v1/plants/{slug}/notes": {
      "get": {"operationId": "listPlantNotes"},
      "post": {"operationId": "addPlantNote"}
    },
    "/v1/notes": {
      "get": {"operationId": "listHouseholdNotes"},
      "post": {"operationId": "addHouseholdNote"}
    },
    "/v1/notes/{id}": {
      "patch": {"operationId": "updateNote"},
      "delete": {"operationId": "deleteNote"}
    },
    "/v1/harvests": {"get": {"operationId": "listHarvests"}},
    "/v1/harvests/summary": {"get": {"operationId": "harvestSummary"}},
    "/v1/harvests/{id}": {
      "patch": {"operationId": "updateHarvest"},
      "delete": {"operationId": "deleteHarvest"}
    },
    "/v1/plants/{slug}/harvests": {
      "get": {"operationId": "listPlantHarvests"},
      "post": {"operationId": "addHarvest"}
    },
    "/v1/plants/{slug}/photos": {"post": {"operationId": "uploadPhoto"}},
    "/v1/photos/{id}": {"delete": {"operationId": "deletePhoto"}},
    "/v1/plants/{slug}/timeline": {"get": {"operationId": "getTimeline"}},
    "/v1/plants/{slug}/ask": {"post": {"operationId": "askPlant"}},
    "/v1/plants/{slug}/assess": {"post": {"operationId": "assessPlant"}},
    "/v1/plants/{slug}/conversations": {"get": {"operationId": "listPlantConversations"}},
    "/v1/plants/{slug}/conversations/{id}": {"get": {"operationId": "getPlantConversation"}},
    "/v1/plants/{slug}/conversations/{id}/messages": {"post": {"operationId": "enqueuePlantMessage"}},
    "/v1/conversations/{id}": {"get": {"operationId": "getScratchConversation"}},
    "/v1/conversations/{id}/messages": {"post": {"operationId": "enqueueScratchMessage"}},
    "/v1/plants/{slug}/reminders": {
      "get": {"operationId": "listReminders"},
      "put": {"operationId": "setReminder"}
    },
    "/v1/plants/{slug}/reminders/{kind}": {"delete": {"operationId": "deleteReminder"}},
    "/v1/reminders/{id}/complete": {"post": {"operationId": "completeReminder"}},
    "/v1/reminders/{id}/resolve": {"post": {"operationId": "resolveReminder"}},
    "/v1/ask": {"post": {"operationId": "ask"}},
    "/v1/identify": {"post": {"operationId": "identify"}},
    "/v1/identifications/{id}": {
      "get": {"operationId": "getIdentification"},
      "post": {"operationId": "enqueueIdentification"}
    },
    "/v1/postmortems": {"get": {"operationId": "listPostmortems"}},
    "/v1/plants/{slug}/postmortem": {"post": {"operationId": "createPostmortem"}},
    "/v1/today": {"get": {"operationId": "today"}},
    "/v1/verdicts/{id}/ack": {"post": {"operationId": "ackVerdict"}},
    "/v1/verdicts/{id}/complete": {"post": {"operationId": "completeVerdict"}},
    "/v1/incidents": {"get": {"operationId": "listIncidents"}},
    "/v1/incidents/{id}": {"get": {"operationId": "getIncident"}},
    "/v1/incidents/{id}/acknowledge": {"post": {"operationId": "acknowledgeIncident"}},
    "/v1/incidents/{id}/resolve": {"post": {"operationId": "resolveIncident"}},
    "/v1/choices": {"get": {"operationId": "listChoices"}},
    "/v1/home-assistant/entities": {"get": {"operationId": "listHomeAssistantEntities"}},
    "/v1/home-assistant/actuators": {"get": {"operationId": "discoverActuators"}},
    "/v1/actuators": {
      "get": {"operationId": "listActuators"},
      "post": {"operationId": "registerActuator"}
    },
    "/v1/actuators/{id}": {
      "patch": {"operationId": "updateActuator"},
      "delete": {"operationId": "deleteActuator"}
    },
    "/v1/actuators/{id}/events": {"get": {"operationId": "listActuatorEvents"}},
    "/v1/actuators/{id}/start": {"post": {"operationId": "startActuator"}},
    "/v1/actuators/{id}/stop": {"post": {"operationId": "stopActuator"}},
    "/v1/actuators/{id}/state": {"post": {"operationId": "setActuatorState"}},
    "/v1/actuators/{id}/light-schedule": {
      "put": {"operationId": "setLightSchedule"},
      "delete": {"operationId": "deleteLightSchedule"}
    },
    "/v1/actuators/{id}/fan-schedule": {
      "put": {"operationId": "setFanSchedule"},
      "delete": {"operationId": "deleteFanSchedule"}
    },
    "/v1/sensors": {
      "get": {"operationId": "listSensors"},
      "post": {"operationId": "linkSensor"}
    },
    "/v1/sensors/{id}": {"patch": {"operationId": "calibrateSensor"}},
    "/v1/sensors/{id}/assignment": {"put": {"operationId": "updateSensorAssignment"}},
    "/v1/calibration-proposals/{id}/approve": {"post": {"operationId": "approveCalibrationProposal"}},
    "/v1/calibration-proposals/{id}/deny": {"post": {"operationId": "denyCalibrationProposal"}},
    "/v1/questions": {
      "get": {"operationId": "listQuestions"},
      "post": {"operationId": "createQuestion"}
    },
    "/v1/questions/{id}/answer": {"post": {"operationId": "answerQuestion"}},
    "/v1/owner-update": {"post": {"operationId": "createOwnerUpdate"}},
    "/v1/push-devices": {"post": {"operationId": "registerPushDevice"}},
    "/v1/push/health": {"get": {"operationId": "pushHealth"}},
    "/v1/push/test": {"post": {"operationId": "testPush"}},
    "/v1/models": {"get": {"operationId": "listModels"}},
    "/v1/model-assignments": {"get": {"operationId": "listModelAssignments"}},
    "/v1/model-assignments/{job}": {
      "put": {"operationId": "setModelAssignment"},
      "delete": {"operationId": "clearModelAssignment"}
    },
    "/v1/prompt-instructions": {"get": {"operationId": "listPromptInstructions"}},
    "/v1/prompt-instructions/{job}": {
      "put": {"operationId": "setPromptInstruction"},
      "delete": {"operationId": "clearPromptInstruction"}
    },
    "/v1/policies": {
      "get": {"operationId": "listPolicies"},
      "post": {"operationId": "createPolicy"}
    },
    "/v1/policies/preview": {"post": {"operationId": "previewPolicy"}},
    "/v1/policies/reference": {"get": {"operationId": "getPolicyReference"}},
    "/v1/policies/{id}": {
      "get": {"operationId": "getPolicy"},
      "put": {"operationId": "updatePolicy"},
      "delete": {"operationId": "deletePolicy"}
    },
    "/v1/policies/{id}/evaluate": {"post": {"operationId": "evaluatePolicy"}},
    "/v1/policy-evaluations": {"get": {"operationId": "listPolicyEvaluations"}},
    "/v1/scheduled-jobs": {"get": {"operationId": "listScheduledJobs"}},
    "/v1/scheduled-jobs/{job}/runs": {"post": {"operationId": "runScheduledJob"}},
    "/v1/away": {
      "get": {"operationId": "listAway"},
      "post": {"operationId": "createAway"}
    },
    "/v1/away/{id}": {
      "patch": {"operationId": "updateAway"},
      "delete": {"operationId": "deleteAway"}
    },
    "/v1/cold-watch": {"get": {"operationId": "coldWatch"}},
    "/v1/shelter": {"post": {"operationId": "shelter"}},
    "/v1/unshelter": {"post": {"operationId": "unshelter"}}
  },
  "components": {
    "schemas": {
      "PlantDomain": {"type": "string", "enum": ["houseplant", "edible_indoor", "edible_outdoor"]},
      "PlantStatus": {"type": "string", "enum": ["alive", "struggling", "dormant", "dead", "removed"]},
      "WateringMethod": {"type": "string", "enum": ["letpot", "hand"]},
      "PlantAccessibility": {"type": "string", "enum": ["easy", "awkward", "hard"]},
      "LightExposure": {"type": "string", "enum": ["direct", "bright_indirect", "medium", "low"]},
      "VerdictAction": {"type": "string", "enum": ["none", "water", "check", "urgent", "harvest"]},
      "ObservationKind": {"type": "string", "enum": ["watered", "airflow", "misted", "repotted", "fertilized", "pruned", "harvested", "moved", "symptom", "note", "died"]},
      "ObservationSource": {"type": "string", "enum": ["app", "agent", "automation"]},
      "ReminderDisposition": {"type": "string", "enum": ["completed", "missed"]},
      "HealthChangeKind": {"type": "string", "enum": ["baseline", "delta"]},
      "ActuatorKind": {"type": "string", "enum": ["fan", "switch", "light", "water"]},
      "ActuatorEventAction": {"type": "string", "enum": ["start_requested", "started", "start_failed", "stop_requested", "stopped", "stop_failed", "stop_noop", "state_changed", "schedule_updated", "schedule_disabled", "schedule_failed"]},
      "EvidenceWindowKind": {"type": "string", "enum": ["recheck", "experiment"]},
      "EvidenceWindowStatus": {"type": "string", "enum": ["proposed", "active", "ready", "completed", "cancelled"]},
      "EvidenceKind": {"type": "string", "enum": ["observation", "photo", "reading"]},
      "EvidencePhase": {"type": "string", "enum": ["baseline", "review"]},
      "EvidenceWindowOutcome": {"type": "string", "enum": ["improved", "unchanged", "worsened", "insufficient_evidence", "supported", "not_supported", "inconclusive", "stopped_for_safety", "cancelled"]},
      "IncidentStatus": {"type": "string", "enum": ["open", "acknowledged", "resolved"]},
      "IncidentFactor": {"type": "string", "enum": ["ha_area", "location", "common_care", "environment_failure", "actuator_failure"]},
      "IncidentResolution": {"type": "string", "enum": ["confirmed_common_cause", "unrelated", "contained", "inconclusive"]},
      "SensorRole": {"type": "string", "enum": ["soil_moisture", "ambient_temp", "ambient_humidity", "illuminance"]},
      "AIJob": {"type": "string", "enum": ["assess", "identify", "consult", "ask", "postmortem", "owner_update"]},
      "PolicyMode": {"type": "string", "enum": ["advisory", "enforce"]},
      "PolicyTrigger": {"type": "string", "enum": ["preview", "manual", "daily", "agent"]},
      "PolicySeverity": {"type": "string", "enum": ["info", "warning", "critical"]},
      "PromptInstruction": {
        "type": "object",
        "required": ["job", "instructions"],
        "properties": {
          "job": {"type": "string"},
          "instructions": {"type": "string"},
          "updated_at": {"type": "string"}
        }
      },
      "PromptInstructionUpdate": {
        "type": "object",
        "required": ["instructions"],
        "properties": {
          "instructions": {"type": "string"}
        }
      },
      "APIError": {
        "type": "object",
        "x-swift-name": "APIErrorBody",
        "required": ["error"],
        "properties": {
          "error": {"type": "string"},
          "code": {"type": "string"},
          "request_id": {"type": "string"}
        }
      }
    }
  }
}
